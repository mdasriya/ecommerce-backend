# Copy this file to `.env` and fill in real values.
# NEVER commit `.env`. This example file contains no secrets and is safe to commit.

# --- Database (Neon) ---
# Format: postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
DATABASE_URL=

# --- App ---
# development | test | production   (production disables /docs and /redoc)
ENVIRONMENT=development

# --- JWT ---
# Generate a strong secret (min 32 chars) with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# Use a DIFFERENT secret in every environment. Changing it logs everyone out.
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- CORS ---
# JSON list of frontend origins allowed to call the API. Never "*" in production.
CORS_ORIGINS=["http://localhost:3000"]
